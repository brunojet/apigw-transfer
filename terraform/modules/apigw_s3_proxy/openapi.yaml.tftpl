# Contrato da API — gerado a partir deste template pelo Terraform
# (templatefile em main.tf). Isso é o que "compete ao contrato": paths,
# methods, integrações com o S3, mapeamento de headers/status. O Terraform
# só injeta os valores (região, bucket, role) e gerencia o wrapper de
# infra (REST API, deployment, stage, IAM, binary_media_types -- esse
# último fica como atributo nativo do aws_api_gateway_rest_api, não como
# extensão aqui, porque PutRestApi em modo "overwrite" não honra
# x-amazon-apigateway-binary-media-types de forma confiável em updates).
#
# Ref.: SPEC.md seção 4 (fluxo) e seção 5 (binary media types / teto de
# payload). Sem mTLS/autorização nesta rodada (adiado — PLAN.md Fases 4-5).
#
# 404 -> 302 -> /fallback/{key} -> 302 -> 200/206: totalmente transparente
# pra um cliente HTTP que segue redirect (curl -L, browsers, a maioria das
# libs) -- ver detalhes no comentário do bloco "404" abaixo.
openapi: "3.0.1"
info:
  title: "${api_name}"
  version: "1.0"
paths:
  "/{key+}":
    get:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
        - name: "Range"
          in: "header"
          required: false
          schema:
            type: "string"
        - name: "If-Match"
          in: "header"
          required: false
          schema:
            type: "string"
      responses:
        "200":
          description: "objeto completo"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "206":
          description: "chunk parcial (requisicao com Range)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Content-Range: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "302":
          description: "objeto ausente no S3 -- redirect pro /fallback/{key} (cliente resolve o template)"
          headers:
            Location: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "412":
          description: "If-Match nao bate -- objeto mudou desde o ETag que o cliente tinha (ver docs/client-behavior.md)"
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "GET"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/${bucket_name}/{key}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.key: "method.request.path.key"
          integration.request.header.Range: "method.request.header.Range"
          integration.request.header.If-Match: "method.request.header.If-Match"
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "206":
            statusCode: "206"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Content-Range: "integration.response.header.Content-Range"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "412":
            statusCode: "412"
          "404":
            statusCode: "302"
            responseParameters:
              # Location dinamico de verdade, montado no responseTemplates
              # abaixo via $context.responseOverride.header.Location -- por
              # isso o valor aqui e' so uma referencia de base
              # (integration.response.header.Location, que o S3 nunca
              # manda) e nao um literal: um literal como base bloqueia o
              # override (fica preso no valor estatico, sem erro).
              method.response.header.Location: integration.response.header.Location
              method.response.header.Cache-Control: "'no-cache, no-store, must-revalidate'"
            responseTemplates:
              # $default (nao "application/json"/"*/*") para funcionar com
              # qualquer Accept do cliente, sem precisar negociar
              # content-type. $input.params('key') funciona aqui porque
              # essa integration response nao e' mais tratada como binaria
              # -- binary_media_types (ver main.tf) foi restrito aos
              # content-types reais que o proxy serve; com "*/*" o S3
              # (application/xml no erro) virava [Binary Data] e VTL nunca
              # roda em cima de binario ("Unable to transform response",
              # visivel so com CloudWatch Logs habilitado -- ver memoria de
              # projeto pra como isso foi diagnosticado).
              $default: |
                #set($key = $input.params('key'))
                #set($context.responseOverride.header.Location = "/${stage_name}/fallback/$key")
    head:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      responses:
        "200":
          description: "descoberta de tamanho (HeadObject)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "302":
          description: "objeto ausente no S3 -- redirect pro /fallback/{key} (cliente resolve o template)"
          headers:
            Location: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "HEAD"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/${bucket_name}/{key}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.key: "method.request.path.key"
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "404":
            statusCode: "302"
            responseParameters:
              # Location dinamico de verdade, montado no responseTemplates
              # abaixo via $context.responseOverride.header.Location -- por
              # isso o valor aqui e' so uma referencia de base
              # (integration.response.header.Location, que o S3 nunca
              # manda) e nao um literal: um literal como base bloqueia o
              # override (fica preso no valor estatico, sem erro).
              method.response.header.Location: integration.response.header.Location
              method.response.header.Cache-Control: "'no-cache, no-store, must-revalidate'"
            responseTemplates:
              # $default (nao "application/json"/"*/*") para funcionar com
              # qualquer Accept do cliente, sem precisar negociar
              # content-type. $input.params('key') funciona aqui porque
              # essa integration response nao e' mais tratada como binaria
              # -- binary_media_types (ver main.tf) foi restrito aos
              # content-types reais que o proxy serve; com "*/*" o S3
              # (application/xml no erro) virava [Binary Data] e VTL nunca
              # roda em cima de binario ("Unable to transform response",
              # visivel so com CloudWatch Logs habilitado -- ver memoria de
              # projeto pra como isso foi diagnosticado).
              $default: |
                #set($key = $input.params('key'))
                #set($context.responseOverride.header.Location = "/${stage_name}/fallback/$key")
  # ---------------------------------------------------------------
  # SPIKE ISOLADO -- servidor sempre ajusta/injeta o Range antes de
  # repassar ao S3, garantindo que nenhum chunk devolvido passe de
  # range_clamp_max_chunk_bytes+1 bytes, mesmo que o cliente peça mais
  # (ou nao peca Range nenhum). Fora do escopo desta rodada: sem
  # If-Match/412, sem 404->fallback -- so valida a mecanica do clamp em
  # si. Ver PLAN.md Fase 3.6. NAO usado por /{key+} de producao.
  #
  # Achado ainda nao confirmado contra a AWS real (documentar aqui
  # quando validado): $input.params('Range') devolve String (via
  # String.split()), e Velocity nao converte String pra Number
  # automaticamente em operadores aritmeticos -- por isso o
  # $Integer.parseInt(...) abaixo, em vez de somar a String direto.
  # ---------------------------------------------------------------
  "/test-range-clamp/{key+}":
    get:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
        - name: "Range"
          in: "header"
          required: false
          schema:
            type: "string"
      responses:
        "206":
          description: "chunk parcial -- nunca maior que range_clamp_max_chunk_bytes+1 bytes, independente do que o cliente pediu (ou se nao pediu Range nenhum)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Content-Range: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
        "416":
          description: "range nao satisfazivel (ex.: start >= tamanho do objeto)"
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "GET"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/${bucket_name}/{key}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.key: "method.request.path.key"
        requestTemplates:
          # $default (nao "application/json") -- um GET normalmente nao
          # manda Content-Type, e com passthroughBehavior=when_no_match a
          # falta de match faria a requisicao passar sem transformacao
          # nenhuma, ou seja, o clamp de Range nunca rodaria de verdade.
          $default: |
            #set($Integer = 0)
            #set($maxChunk = ${range_clamp_max_chunk_bytes})
            #set($rawRange = $input.params('Range'))
            #if($rawRange && $rawRange != "")
              #set($rangeBody = $rawRange.replaceAll("bytes=", ""))
              #set($parts = $rangeBody.split("-"))
              #set($rangeStart = $Integer.parseInt($parts.get(0).trim()))
              #if($parts.size() > 1 && $parts.get(1) && $parts.get(1).trim() != "")
                #set($clientEnd = $Integer.parseInt($parts.get(1).trim()))
                #set($safeEnd = $rangeStart + $maxChunk)
                #if($clientEnd > $safeEnd)
                  #set($rangeEnd = $safeEnd)
                #else
                  #set($rangeEnd = $clientEnd)
                #end
              #else
                ## "bytes=N-" sem fim definido -> aplica limite a partir do inicio
                #set($rangeEnd = $rangeStart + $maxChunk)
              #end
            #else
              ## Sem header Range -> assume inicio 0 com limite seguro.
              ## Isso torna a resposta 200 (objeto inteiro) inalcancavel
              ## por design neste path -- e' o comportamento sendo testado.
              #set($rangeStart = 0)
              #set($rangeEnd = $maxChunk)
            #end
            ## $rangeStart-$rangeEnd (sem chaves) NAO funciona: Velocity
            ## aceita hifen em nome de referencia, entao "$rangeStart-"
            ## vira o nome de UMA referencia so ("rangeStart-", inexistente,
            ## renderiza vazio) em vez de "$rangeStart" seguido do literal
            ## "-". $${...} (chaves, escapado pro Terraform nao tentar
            ## interpolar como variavel dele) delimita a referencia sem
            ## ambiguidade. Achado real, confirmado via CloudWatch Logs
            ## (Add Range: bytes=8388607, faltando o "0-" do inicio).
            #set($context.requestOverride.header.Range = "bytes=$${rangeStart}-$${rangeEnd}")
        responses:
          "206":
            statusCode: "206"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Content-Range: "integration.response.header.Content-Range"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
          "416":
            statusCode: "416"
          default:
            statusCode: "500"
  "/fallback/{key+}":
    get:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
    head:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
