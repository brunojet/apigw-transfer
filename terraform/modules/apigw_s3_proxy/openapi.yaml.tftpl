# Contrato da API — gerado a partir deste template pelo Terraform
# (templatefile em main.tf). Isso é o que "compete ao contrato": paths,
# methods, integrações com o S3, mapeamento de headers/status. O Terraform
# só injeta os valores (região, role, canais de entrega) e gerencia o
# wrapper de infra (REST API, deployment, stage, IAM, binary_media_types --
# esse último fica como atributo nativo do aws_api_gateway_rest_api, não
# como extensão aqui, porque PutRestApi em modo "overwrite" não honra
# x-amazon-apigateway-binary-media-types de forma confiável em updates).
#
# Rotas (contrato publicado):
#   GET/HEAD /files-delivery/{fileDeliveryId}/files/{fileId}
#   GET/HEAD /files-delivery/{fileDeliveryId}/retrievals/{retrievalId}
#
# A key no S3 é "{fileDeliveryId}/{fileId}" (ex.: apk/<fileId>) e
# retrievalId é o próprio fileId (no máximo uma busca por arquivo,
# garantido pelo lock). Os valores aceitos de fileDeliveryId vêm de
# var.file_delivery_ids (enum abaixo; o API Gateway não valida enum -- um
# valor fora da lista não existe no S3: files redireciona e retrievals
# responde 404 "unknown fileDeliveryId").
# Cache-Control vem do metadado do objeto no S3, gravado pela cópia do
# fallback conforme o canal (image: cache longo; apk: sem cache) -- por
# isso o header é repassado, não fixado aqui.
#
# files/{fileId} ausente no S3 -> 302 -> retrievals/{fileId} -> 202 (busca
# em andamento) ou 302 de volta -> 200/206: transparente pra um cliente
# HTTP que segue redirect. Ref.: SPEC.md §4/§5/§9, docs/client-behavior.md.
openapi: "3.0.1"
info:
  title: "${api_name}"
  version: "1.0"
paths:
  "/files-delivery/{fileDeliveryId}/files/{fileId}":
    get:
      parameters:
        - name: "fileDeliveryId"
          in: "path"
          required: true
          schema:
            type: "string"
            enum: ${jsonencode(file_delivery_ids)}
        - name: "fileId"
          in: "path"
          required: true
          schema:
            type: "string"
        - name: "Range"
          in: "header"
          required: false
          schema:
            type: "string"
        - name: "If-Match"
          in: "header"
          required: false
          schema:
            type: "string"
      responses:
        "200":
          description: "defensivo -- o servidor sempre injeta um Range (ver requestTemplates abaixo), entao o S3 normalmente responde 206"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "206":
          description: "bloco do arquivo (tamanho decidido pelo servidor)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Content-Range: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "302":
          description: "arquivo ausente no S3 -- redirect pra /files-delivery/{fileDeliveryId}/retrievals/{fileId}"
          headers:
            Location: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "403":
          description: "acesso negado pelo S3 -- corpo generico, sem o XML do S3"
          headers:
            Content-Type: { schema: { type: "string" } }
        "412":
          description: "If-Match nao bate -- arquivo mudou desde o ETag que o cliente tinha -- corpo generico"
          headers:
            Content-Type: { schema: { type: "string" } }
        "416":
          description: "Range alem do fim do arquivo -- corpo generico"
          headers:
            Content-Type: { schema: { type: "string" } }
        "502":
          description: "qualquer outro status do S3 (catch-all) -- corpo generico"
          headers:
            Content-Type: { schema: { type: "string" } }
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "GET"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/$${stageVariables.bucketName}/{fileDeliveryId}/{fileId}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.fileDeliveryId: "method.request.path.fileDeliveryId"
          integration.request.path.fileId: "method.request.path.fileId"
          integration.request.header.If-Match: "method.request.header.If-Match"
        requestTemplates:
          # $default (nao "application/json") -- GET normalmente nao manda
          # Content-Type; sem match, a requisicao passaria sem transformacao
          # e o clamp de Range nunca rodaria. Historico do clamp e do bug de
          # hifen em nome de referencia do Velocity: SPEC.md §9.
          $default: |
            #set($Integer = 0)
            #set($maxChunk = $Integer.parseInt($stageVariables.maxChunkBytes))
            #set($rawRange = $input.params('Range'))
            ## Formatos aceitos: "bytes=N-" e "bytes=N-M". Ausente ou qualquer
            ## outro formato e' ignorado (RFC 9110) e tratado como "bytes=0-":
            ## repassar um Range invalido faria o S3 devolver o arquivo inteiro,
            ## contornando o clamp. \d{1,9} mantem inicio + maxChunk dentro de
            ## int (enderecavel ate ~950MB).
            #if(!$rawRange || !$rawRange.matches("bytes=\d{1,9}-\d{0,9}"))
              #set($rawRange = "bytes=0-")
            #end
            ## split com limite -1 preserva o fim vazio de "bytes=N-"
            #set($parts = $rawRange.substring(6).split("-", -1))
            #set($rangeStart = $Integer.parseInt($parts.get(0)))
            #set($rangeEnd = $rangeStart + $maxChunk)
            #if($parts.get(1) != "")
              #set($clientEnd = $Integer.parseInt($parts.get(1)))
              #if($clientEnd < $rangeStart)
                #set($rangeStart = 0)
                #set($rangeEnd = $maxChunk)
              #elseif($clientEnd < $rangeEnd)
                #set($rangeEnd = $clientEnd)
              #end
            #end
            ## $${...} delimita a referencia: "$rangeStart-" seria lido como
            ## uma referencia so, com hifen no nome (SPEC.md §9).
            #set($context.requestOverride.header.Range = "bytes=$${rangeStart}-$${rangeEnd}")
        responses:
          "200":
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
              method.response.header.Cache-Control: "integration.response.header.Cache-Control"
          "206":
            statusCode: "206"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Content-Range: "integration.response.header.Content-Range"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
              method.response.header.Cache-Control: "integration.response.header.Cache-Control"
          "403":
            statusCode: "403"
            responseParameters:
              method.response.header.Content-Type: "'application/json'"
            responseTemplates:
              $default: '{"status":403,"detail":"access denied"}'
          "404":
            statusCode: "302"
            responseParameters:
              # Base dinamica (integration.response.header.Location, que o S3
              # nunca manda), nao literal: um literal bloqueia o override do
              # responseTemplates abaixo, sem erro.
              method.response.header.Location: integration.response.header.Location
              method.response.header.Cache-Control: "'no-cache, no-store, must-revalidate'"
            responseTemplates:
              # $default funciona com qualquer Accept. O VTL so roda porque o
              # XML de erro do S3 (application/xml) fica fora de
              # binary_media_types -- com "*/*" viraria binario (SPEC.md §5).
              $default: |
                #set($context.responseOverride.header.Location = "/$context.stage/files-delivery/$input.params('fileDeliveryId')/retrievals/$input.params('fileId')")
          "412":
            statusCode: "412"
            responseParameters:
              method.response.header.Content-Type: "'application/json'"
            responseTemplates:
              $default: '{"status":412,"detail":"precondition failed"}'
          "416":
            statusCode: "416"
            responseParameters:
              method.response.header.Content-Type: "'application/json'"
            responseTemplates:
              $default: '{"status":416,"detail":"requested range not satisfiable"}'
          # "default" (sem selectionPattern) pega QUALQUER status nao listado
          # acima -- por isso e' erro (502), nunca 200.
          default:
            statusCode: "502"
            responseParameters:
              method.response.header.Content-Type: "'application/json'"
            responseTemplates:
              $default: '{"status":502,"detail":"upstream error"}'
    head:
      parameters:
        - name: "fileDeliveryId"
          in: "path"
          required: true
          schema:
            type: "string"
            enum: ${jsonencode(file_delivery_ids)}
        - name: "fileId"
          in: "path"
          required: true
          schema:
            type: "string"
      responses:
        "200":
          description: "tamanho e ETag do arquivo (HeadObject)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "302":
          description: "arquivo ausente no S3 -- redirect pra /files-delivery/{fileDeliveryId}/retrievals/{fileId}"
          headers:
            Location: { schema: { type: "string" } }
            Cache-Control: { schema: { type: "string" } }
        "403":
          description: "acesso negado pelo S3"
        "502":
          description: "qualquer outro status do S3 (catch-all)"
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "HEAD"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/$${stageVariables.bucketName}/{fileDeliveryId}/{fileId}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.fileDeliveryId: "method.request.path.fileDeliveryId"
          integration.request.path.fileId: "method.request.path.fileId"
        responses:
          "200":
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
              method.response.header.Cache-Control: "integration.response.header.Cache-Control"
          "403":
            statusCode: "403"
          "404":
            statusCode: "302"
            responseParameters:
              method.response.header.Location: integration.response.header.Location
              method.response.header.Cache-Control: "'no-cache, no-store, must-revalidate'"
            responseTemplates:
              $default: |
                #set($context.responseOverride.header.Location = "/$context.stage/files-delivery/$input.params('fileDeliveryId')/retrievals/$input.params('fileId')")
          default:
            statusCode: "502"
  "/files-delivery/{fileDeliveryId}/retrievals/{retrievalId}":
    get:
      parameters:
        - name: "fileDeliveryId"
          in: "path"
          required: true
          schema:
            type: "string"
            enum: ${jsonencode(file_delivery_ids)}
        - name: "retrievalId"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
    head:
      parameters:
        - name: "fileDeliveryId"
          in: "path"
          required: true
          schema:
            type: "string"
            enum: ${jsonencode(file_delivery_ids)}
        - name: "retrievalId"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
