# Contrato da API — gerado a partir deste template pelo Terraform
# (templatefile em main.tf). Isso é o que "compete ao contrato": paths,
# methods, integrações com o S3, mapeamento de headers/status e binary
# media types. O Terraform só injeta os valores (região, bucket, role) e
# gerencia o wrapper de infra (REST API, deployment, stage, IAM).
#
# Ref.: SPEC.md seção 4 (fluxo) e seção 5 (binary media types / teto de
# payload). Sem mTLS/autorização nesta rodada (adiado — PLAN.md Fases 4-5).
#
# 404 -> 302: quando o S3 não acha o objeto, em vez de repassar o 404,
# devolvemos um 302 com Location. Por enquanto o Location é um PLACEHOLDER
# ESTATICO — só valida que o mapeamento de status dispara certo. A Lambda
# real de cache-miss (busca no upstream + lock distribuído) fica pra uma
# rodada futura (ver conversa/registro no PLAN.md).
openapi: "3.0.1"
info:
  title: "${api_name}"
  version: "1.0"
paths:
  "/{key+}":
    get:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
        - name: "Range"
          in: "header"
          required: false
          schema:
            type: "string"
      responses:
        "200":
          description: "objeto completo"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "206":
          description: "chunk parcial (requisicao com Range)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Content-Range: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "302":
          description: "objeto ausente no S3 -- redirect (placeholder, ainda sem Lambda de cache-miss)"
          headers:
            Location: { schema: { type: "string" } }
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "GET"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/${bucket_name}/{key}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.key: "method.request.path.key"
          integration.request.header.Range: "method.request.header.Range"
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "206":
            statusCode: "206"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Content-Range: "integration.response.header.Content-Range"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "404":
            statusCode: "302"
            responseParameters:
              # /fallback/{key} -- mesmo nome do Lambda de fallback do
              # go-edge-cache (cmd/fallback/). Endpoint ainda nao existe
              # (sera implementado numa rodada futura); aqui so validamos
              # que o mapeamento 404 -> 302 dispara com a key correta.
              method.response.header.Location: "'https://example.com/cache-miss-fetch-not-implemented-yet'"
    head:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      responses:
        "200":
          description: "descoberta de tamanho (HeadObject)"
          headers:
            Content-Type: { schema: { type: "string" } }
            Content-Length: { schema: { type: "string" } }
            Accept-Ranges: { schema: { type: "string" } }
            ETag: { schema: { type: "string" } }
        "302":
          description: "objeto ausente no S3 -- redirect (placeholder, ainda sem Lambda de cache-miss)"
          headers:
            Location: { schema: { type: "string" } }
      x-amazon-apigateway-integration:
        type: "aws"
        httpMethod: "HEAD"
        uri: "arn:aws:apigateway:${aws_region}:s3:path/${bucket_name}/{key}"
        credentials: "${execution_role_arn}"
        passthroughBehavior: "when_no_match"
        requestParameters:
          integration.request.path.key: "method.request.path.key"
        responses:
          default:
            statusCode: "200"
            responseParameters:
              method.response.header.Content-Type: "integration.response.header.Content-Type"
              method.response.header.Content-Length: "integration.response.header.Content-Length"
              method.response.header.Accept-Ranges: "integration.response.header.Accept-Ranges"
              method.response.header.ETag: "integration.response.header.ETag"
          "404":
            statusCode: "302"
            responseParameters:
              # /fallback/{key} -- mesmo nome do Lambda de fallback do
              # go-edge-cache (cmd/fallback/). Endpoint ainda nao existe
              # (sera implementado numa rodada futura); aqui so validamos
              # que o mapeamento 404 -> 302 dispara com a key correta.
              method.response.header.Location: "'https://example.com/cache-miss-fetch-not-implemented-yet'"
  "/fallback/{key+}":
    get:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
    head:
      parameters:
        - name: "key"
          in: "path"
          required: true
          schema:
            type: "string"
      x-amazon-apigateway-integration:
        type: "aws_proxy"
        httpMethod: "POST"
        uri: "${fallback_lambda_invoke_arn}"
        passthroughBehavior: "when_no_match"
x-amazon-apigateway-binary-media-types:
%{ for mt in binary_media_types ~}
  - "${mt}"
%{ endfor ~}
